<!-- The countdown: a small always-on-top number (5, 4, 3, 2, 1) in the middle of the screen while a delayed capture waits, so the
     user can open the menu or tooltip they need. DataContext: CountdownViewModel. It never takes focus, so a key the user is
     pressing in the other application is not stolen. -->
<Window x:Class="Paper.ScreenWizzard.Presentation.Capture.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Capture.Countdown.Title}"
        AutomationProperties.Name="{DynamicResource Capture.Countdown.Title}"
        AutomationProperties.AutomationId="CountdownWindow"
        Background="{DynamicResource Brush.ToastBackground}"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
  <Border MinHeight="120" MinWidth="120" Padding="24,12">
    <TextBlock x:Name="NumberText"
               AutomationProperties.AutomationId="CountdownText"
               AutomationProperties.LiveSetting="Polite"
               FontFamily="Segoe UI"
               FontSize="72"
               FontWeight="SemiBold"
               Foreground="{DynamicResource Brush.ToastText}"
               HorizontalAlignment="Center"
               RenderTransformOrigin="0.5,0.5"
               Text="{Binding Text}"
               VerticalAlignment="Center">
      <TextBlock.RenderTransform>
        <ScaleTransform x:Name="PulseScale" />
      </TextBlock.RenderTransform>
    </TextBlock>
  </Border>
</Window>
