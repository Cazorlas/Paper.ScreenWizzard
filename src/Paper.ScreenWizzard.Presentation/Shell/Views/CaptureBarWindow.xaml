<!-- The capture bar: a small always-on-top window with one button per capture kind, a Settings button and a close button.
     DataContext: CaptureBarViewModel, passed to the constructor by the composition root. The bar captures nothing itself; its
     buttons run commands that raise events.
     No title bar, so the window is dragged by its own surface (code-behind: DragMove). Buttons take their own clicks. -->
<Window x:Class="Paper.ScreenWizzard.Presentation.Shell.Views.CaptureBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:capture="clr-namespace:Paper.ScreenWizzard.Domain.Capture;assembly=Paper.ScreenWizzard.Domain"
        Title="{DynamicResource CaptureBar.Title}"
        AutomationProperties.Name="{DynamicResource CaptureBar.Title}"
        AutomationProperties.AutomationId="CaptureBarWindow"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Paper.ScreenWizzard.Presentation;component/Resources/Controls.xaml" />
        <ResourceDictionary Source="/Paper.ScreenWizzard.Presentation;component/Resources/Icons.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Every glyph is stroked with the theme's icon brush. -->
      <Style x:Key="Style.Glyph" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource Brush.Icon}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <!-- The 1 px frame and the padding are the bar's own surface: the part the user can grab to drag it. -->
  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="6">
    <StackPanel Orientation="Horizontal">
      <Button AutomationProperties.AutomationId="CaptureButton.Rectangle"
              AutomationProperties.Name="{DynamicResource Capture.Kind.Rectangle}"
              ToolTip="{DynamicResource Capture.Kind.Rectangle}"
              Command="{Binding CaptureCommand}"
              CommandParameter="{x:Static capture:CaptureKind.Rectangle}"
              Style="{StaticResource Style.Button.Icon}" Padding="10,6">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Rectangle}" StrokeDashArray="2 1.5" />
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource CaptureBar.Rectangle}" />
        </StackPanel>
      </Button>
      <Button AutomationProperties.AutomationId="CaptureButton.Freeform"
              AutomationProperties.Name="{DynamicResource Capture.Kind.Freeform}"
              ToolTip="{DynamicResource Capture.Kind.Freeform}"
              Command="{Binding CaptureCommand}"
              CommandParameter="{x:Static capture:CaptureKind.Freeform}"
              Style="{StaticResource Style.Button.Icon}" Padding="10,6">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Freeform}" />
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource CaptureBar.Freeform}" />
        </StackPanel>
      </Button>
      <Button AutomationProperties.AutomationId="CaptureButton.Window"
              AutomationProperties.Name="{DynamicResource Capture.Kind.Window}"
              ToolTip="{DynamicResource Capture.Kind.Window}"
              Command="{Binding CaptureCommand}"
              CommandParameter="{x:Static capture:CaptureKind.Window}"
              Style="{StaticResource Style.Button.Icon}" Padding="10,6">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Window}" />
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource CaptureBar.Window}" />
        </StackPanel>
      </Button>
      <Button AutomationProperties.AutomationId="CaptureButton.FullScreen"
              AutomationProperties.Name="{DynamicResource Capture.Kind.FullScreen}"
              ToolTip="{DynamicResource Capture.Kind.FullScreen}"
              Command="{Binding CaptureCommand}"
              CommandParameter="{x:Static capture:CaptureKind.FullScreen}"
              Style="{StaticResource Style.Button.Icon}" Padding="10,6">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.FullScreen}" />
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource CaptureBar.FullScreen}" />
        </StackPanel>
      </Button>

      <!-- A thin divider between the capture buttons and the two icon-only ones. -->
      <Border Width="1" Margin="6,6" Background="{DynamicResource Brush.Border}" />

      <!-- Icon-only buttons: the name is what a screen reader reads, and what the tests find them by. -->
      <Button Style="{StaticResource Style.Button.Icon}"
              AutomationProperties.AutomationId="SettingsButton"
              AutomationProperties.Name="{DynamicResource CaptureBar.Settings}"
              ToolTip="{DynamicResource CaptureBar.Settings}"
              Command="{Binding OpenSettingsCommand}">
        <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Settings}" />
      </Button>
      <Button Style="{StaticResource Style.Button.Icon}"
              AutomationProperties.AutomationId="CloseButton"
              AutomationProperties.Name="{DynamicResource CaptureBar.Close}"
              ToolTip="{DynamicResource CaptureBar.Close}"
              Command="{Binding CloseCommand}">
        <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Close}" />
      </Button>
    </StackPanel>
  </Border>
</Window>
