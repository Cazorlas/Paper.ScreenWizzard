<!-- A Yes/No question, shown modally over the window that asked. Yes is the default (Enter), No is the cancel (Esc).
     No DataContext: the caller passes the title and the finished question to the constructor. -->
<Window x:Class="Paper.ScreenWizzard.Presentation.Shell.Views.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="PromptDialog"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        MaxWidth="480"
        MinWidth="320"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Paper.ScreenWizzard.Presentation;component/Resources/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <StackPanel Margin="24,20,24,16">
    <TextBlock x:Name="QuestionText"
               AutomationProperties.AutomationId="PromptText"
               Margin="0,0,0,18"
               TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource Style.Button.Accent}"
              AutomationProperties.AutomationId="PromptYesButton"
              Content="{DynamicResource Prompt.Yes}"
              IsDefault="True"
              MinWidth="96"
              Click="OnYesClick" />
      <Button Margin="8,0,0,0"
              AutomationProperties.AutomationId="PromptNoButton"
              Content="{DynamicResource Prompt.No}"
              IsCancel="True"
              MinWidth="96"
              Click="OnNoClick" />
    </StackPanel>
  </StackPanel>
</Window>
