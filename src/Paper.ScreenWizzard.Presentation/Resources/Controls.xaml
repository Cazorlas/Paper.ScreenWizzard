<!-- Themed look of the controls the shell windows use. Every colour is a DynamicResource brush from Themes/Light.xaml or
     Dark.xaml, so a theme swap recolours open windows. WPF's stock templates ignore most brushes (a check box stays light on a
     dark window), which is why each control has its own template here.

     Focus: WPF's default FocusVisualStyle is a thin dotted rectangle that vanishes on a themed background, so it is turned off
     and every template draws its own 2 px ring in Brush.Focus (>= 3:1 against window, surface and button; a test measures it).
     The ring is drawn inside the control's own bounds so nothing clips it. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Button: the default look. Accent and icon variants are based on it. -->
  <Style x:Key="Style.Button" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Brush.ButtonBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
            <!-- The focus ring, shown only while this button holds keyboard focus. It is two rings: the focus colour outside and a
                 window-coloured line just inside it. Brush.Focus is the accent colour, so on the accent-filled default button
                 (Save) the outer ring alone is the fill itself and Tab would be invisible; the inner line is what shows there. -->
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource Brush.Focus}"
                    BorderThickness="2"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
              <Border Margin="0"
                      BorderBrush="{DynamicResource Brush.Window}"
                      BorderThickness="2"
                      CornerRadius="2" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledText}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.ButtonHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.ButtonPressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Style.Button}" />

  <!-- The default action of a window (Save): filled with the accent colour. Triggers of a derived style run after the base
       ones, so the accent hover and pressed colours win over the grey ones. -->
  <Style x:Key="Style.Button.Accent" TargetType="Button" BasedOn="{StaticResource Style.Button}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A button that shows only a glyph: a larger hit area than the 16 px drawing (skill paper-wpf-style, "hit area"). -->
  <Style x:Key="Style.Button.Icon" TargetType="Button" BasedOn="{StaticResource Style.Button}">
    <Setter Property="Padding" Value="9" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- Check box: a 18 px box in the theme's border colour, ticked with the accent colour. -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent" SnapsToDevicePixels="True" MinHeight="28">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="26" Height="26" VerticalAlignment="Center">
              <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="2" CornerRadius="5" />
              <Border x:Name="Box"
                      Width="18" Height="18"
                      Background="{DynamicResource Brush.Surface}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      BorderThickness="1"
                      CornerRadius="3">
                <Path x:Name="Mark"
                      Data="M3.5,8.5 L7,12 L14,4.5"
                      Stroke="{DynamicResource Brush.AccentText}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Visibility="Collapsed" />
              </Border>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledText}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Radio button: a ring with an accent dot. WPF makes every radio button of a group a Tab stop; here only the chosen one is
       (IsTabStop follows IsChecked), so Tab crosses a group in one press and the arrow keys move between its buttons, as in
       every other Windows app. The panel that holds a group sets KeyboardNavigation.DirectionalNavigation="Cycle". -->
  <Style TargetType="RadioButton">
    <Setter Property="IsTabStop" Value="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" SnapsToDevicePixels="True" MinHeight="28">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="26" Height="26" VerticalAlignment="Center">
              <Ellipse x:Name="FocusRing" Stroke="Transparent" StrokeThickness="2" />
              <Ellipse x:Name="Ring"
                       Width="18" Height="18"
                       Fill="{DynamicResource Brush.Surface}"
                       Stroke="{DynamicResource Brush.Border}"
                       StrokeThickness="1" />
              <Ellipse x:Name="Dot"
                       Width="8" Height="8"
                       Fill="{DynamicResource Brush.Accent}"
                       Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Stroke" Value="{DynamicResource Brush.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledText}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text box. Keyed as well as implicit because HotkeyCaptureBox derives from TextBox and WPF looks an implicit style up by
       the exact type, so that control names this style itself. -->
  <Style x:Key="Style.TextBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="SelectionTextBrush" Value="{DynamicResource Brush.AccentText}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" />
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource Brush.Focus}"
                    BorderThickness="2"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledText}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource Style.TextBox}" />

  <!-- The title of a settings group. -->
  <Style x:Key="Style.GroupHeader" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
</ResourceDictionary>
