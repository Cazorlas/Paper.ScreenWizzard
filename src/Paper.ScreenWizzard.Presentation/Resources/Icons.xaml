<!-- Icons of the capture bar, drawn on a 16 x 16 grid and stroked with Brush.Icon by the view that uses them.
     StaticResource is right here: a geometry never changes with the theme, only the brush does. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dashed rectangle: the region selection. -->
  <Geometry x:Key="Icon.Rectangle">M2,3 H14 V13 H2 Z</Geometry>
  <!-- A lasso loop: the freeform selection. -->
  <Geometry x:Key="Icon.Freeform">M3,9 C1,5 6,2 10,3 C15,4 14,9 9,10 C6.5,10.6 6.5,12.5 8.5,14</Geometry>
  <!-- A window with its title bar. -->
  <Geometry x:Key="Icon.Window">M2,3 H14 V13 H2 Z M2,6 H14</Geometry>
  <!-- Four corner brackets: the whole screen. -->
  <Geometry x:Key="Icon.FullScreen">M2,6 V2 H6 M10,2 H14 V6 M14,10 V14 H10 M6,14 H2 V10</Geometry>
  <!-- A gear: a ring with eight teeth and a hole. -->
  <GeometryGroup x:Key="Icon.Settings">
    <EllipseGeometry Center="8,8" RadiusX="4.2" RadiusY="4.2" />
    <EllipseGeometry Center="8,8" RadiusX="1.6" RadiusY="1.6" />
    <PathGeometry Figures="M12.2,8 L14.6,8 M10.97,10.97 L12.67,12.67 M8,12.2 L8,14.6 M5.03,10.97 L3.33,12.67 M3.8,8 L1.4,8 M5.03,5.03 L3.33,3.33 M8,3.8 L8,1.4 M10.97,5.03 L12.67,3.33" />
  </GeometryGroup>
  <Geometry x:Key="Icon.Close">M3,3 L13,13 M13,3 L3,13</Geometry>
</ResourceDictionary>
