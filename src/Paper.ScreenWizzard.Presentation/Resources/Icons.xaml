<!-- Icons of the capture bar, drawn on a 16 x 16 grid and stroked with Brush.Icon by the view that uses them.
     StaticResource is right here: a geometry never changes with the theme, only the brush does. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dashed rectangle: the region selection. -->
  <Geometry x:Key="Icon.Rectangle">M2,3 H14 V13 H2 Z</Geometry>
  <!-- A lasso loop: the freeform selection. -->
  <Geometry x:Key="Icon.Freeform">M3,9 C1,5 6,2 10,3 C15,4 14,9 9,10 C6.5,10.6 6.5,12.5 8.5,14</Geometry>
  <!-- A window with its title bar. -->
  <Geometry x:Key="Icon.Window">M2,3 H14 V13 H2 Z M2,6 H14</Geometry>
  <!-- Four corner brackets: the whole screen. -->
  <Geometry x:Key="Icon.FullScreen">M2,6 V2 H6 M10,2 H14 V6 M14,10 V14 H10 M6,14 H2 V10</Geometry>
  <!-- A gear: a ring with eight teeth and a hole. -->
  <GeometryGroup x:Key="Icon.Settings">
    <EllipseGeometry Center="8,8" RadiusX="4.2" RadiusY="4.2" />
    <EllipseGeometry Center="8,8" RadiusX="1.6" RadiusY="1.6" />
    <PathGeometry Figures="M12.2,8 L14.6,8 M10.97,10.97 L12.67,12.67 M8,12.2 L8,14.6 M5.03,10.97 L3.33,12.67 M3.8,8 L1.4,8 M5.03,5.03 L3.33,3.33 M8,3.8 L8,1.4 M10.97,5.03 L12.67,3.33" />
  </GeometryGroup>
  <Geometry x:Key="Icon.Close">M3,3 L13,13 M13,3 L3,13</Geometry>
  <!-- Editor: a curved arrow back (undo), its mirror (redo), and a plus (add a colour). -->
  <Geometry x:Key="Icon.Undo">M6,2.5 L3,5.5 L6,8.5 M3,5.5 H10 C14,5.5 14,13 10,13 H5</Geometry>
  <Geometry x:Key="Icon.Redo">M10,2.5 L13,5.5 L10,8.5 M13,5.5 H6 C2,5.5 2,13 6,13 H11</Geometry>
  <Geometry x:Key="Icon.Plus">M8,3 V13 M3,8 H13</Geometry>
  <!-- Recorder: a monitor on its stand, two monitors (the whole desktop), a speaker, a microphone, a pointer arrow, the record dot. -->
  <Geometry x:Key="Icon.Monitor">M2,3 H14 V11 H2 Z M6,14 H10 M8,11 V14</Geometry>
  <Geometry x:Key="Icon.Desktop">M1,4 H7.5 V10 H1 Z M8.5,4 H15 V10 H8.5 Z M3,13 H13</Geometry>
  <Geometry x:Key="Icon.Speaker">M2,6 H5 L9,3 V13 L5,10 H2 Z M11.5,5.5 C13,7 13,9 11.5,10.5</Geometry>
  <Geometry x:Key="Icon.Microphone">M6,3 C6,1.5 10,1.5 10,3 V8 C10,9.5 6,9.5 6,8 Z M4,7.5 C4,12 12,12 12,7.5 M8,11 V14 M6,14 H10</Geometry>
  <Geometry x:Key="Icon.Pointer">M4,2 L4,13 L7,10 L9.5,14.5 L11,13.7 L8.6,9.3 L12.5,9 Z</Geometry>
  <EllipseGeometry x:Key="Icon.Record" Center="8,8" RadiusX="5" RadiusY="5" />
</ResourceDictionary>
