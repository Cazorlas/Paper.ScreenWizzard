<!-- A toast: a small message near the bottom right of the screen that fades in, waits, and fades out. It never takes focus
     (ShowActivated=False, Focusable=False) so it cannot steal a key press from what the user is typing into.
     No DataContext: the presenter passes the finished text to the constructor. -->
<Window x:Class="Paper.ScreenWizzard.Presentation.Shared.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        AutomationProperties.AutomationId="ToastWindow"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Paper.ScreenWizzard.Presentation;component/Resources/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <!-- The margin leaves room for the shadow, which the transparent window would otherwise clip. -->
  <Border Margin="10"
          MaxWidth="400"
          Padding="16,12"
          Background="{DynamicResource Brush.ToastBackground}"
          CornerRadius="6">
    <Border.Effect>
      <DropShadowEffect BlurRadius="10" Opacity="0.35" ShadowDepth="2" />
    </Border.Effect>
    <TextBlock x:Name="MessageText"
               AutomationProperties.AutomationId="ToastText"
               AutomationProperties.LiveSetting="Polite"
               FontFamily="Segoe UI"
               FontSize="13"
               Foreground="{DynamicResource Brush.ToastText}"
               TextWrapping="Wrap" />
  </Border>
</Window>
