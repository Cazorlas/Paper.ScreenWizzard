<!-- The recording bar (SPEC recorder, "What the user does" 2 and 3): what to record as four toggle buttons in one row, the monitor menu
     when there is more than one monitor, the system sound, microphone and pointer switches, Record and close.
     DataContext: RecordingBarViewModel. The bar records nothing itself; Record raises an event and the flow does the rest.
     No title bar: the window is dragged by its own surface (code-behind: DragMove). -->
<Window x:Class="Paper.ScreenWizzard.Presentation.Recorder.Views.RecordingBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:Paper.ScreenWizzard.Presentation.Shared.Views"
        Title="{DynamicResource Recorder.Title}"
        AutomationProperties.Name="{DynamicResource Recorder.Title}"
        AutomationProperties.AutomationId="RecordingBarWindow"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Paper.ScreenWizzard.Presentation;component/Resources/Controls.xaml" />
        <ResourceDictionary Source="/Paper.ScreenWizzard.Presentation;component/Resources/Icons.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <shared:ChoiceConverter x:Key="Choice" />
      <BooleanToVisibilityConverter x:Key="Visible" />
      <Style x:Key="Style.Glyph" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource Brush.Icon}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
      </Style>
      <Style x:Key="Style.Switch" TargetType="ToggleButton">
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <Grid>
                  <ContentPresenter />
                  <!-- Off: a slash across the glyph, so the state reads without colour. -->
                  <Line x:Name="Off" X1="1" Y1="15" X2="15" Y2="1" Stroke="{DynamicResource Brush.Recording}" StrokeThickness="1.5" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Off" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.ButtonHover}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="6">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <!-- What to record: four choices in one row. -->
        <RadioButton GroupName="Target" Style="{StaticResource Style.ToolButton}"
                     AutomationProperties.AutomationId="Target.Monitor"
                     AutomationProperties.Name="{DynamicResource Recorder.Target.Monitor}"
                     ToolTip="{DynamicResource Recorder.Target.Monitor}"
                     IsChecked="{Binding Target, Converter={StaticResource Choice}, ConverterParameter=Monitor}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Monitor}" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Recorder.Target.Monitor}" />
          </StackPanel>
        </RadioButton>
        <ComboBox AutomationProperties.AutomationId="MonitorChoice"
                  AutomationProperties.Name="{DynamicResource Recorder.WhichMonitor}"
                  Margin="0,0,6,0" MinWidth="44" VerticalAlignment="Center"
                  Visibility="{Binding HasSeveralMonitors, Converter={StaticResource Visible}}"
                  ItemsSource="{Binding Monitors}"
                  DisplayMemberPath="Label"
                  SelectedValuePath="Index"
                  SelectedValue="{Binding MonitorIndex}" />
        <RadioButton GroupName="Target" Style="{StaticResource Style.ToolButton}"
                     AutomationProperties.AutomationId="Target.Region"
                     AutomationProperties.Name="{DynamicResource Recorder.Target.Region}"
                     ToolTip="{DynamicResource Recorder.Target.Region}"
                     IsChecked="{Binding Target, Converter={StaticResource Choice}, ConverterParameter=Region}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Rectangle}" StrokeDashArray="2 1.5" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Recorder.Target.Region}" />
          </StackPanel>
        </RadioButton>
        <RadioButton GroupName="Target" Style="{StaticResource Style.ToolButton}"
                     AutomationProperties.AutomationId="Target.Window"
                     AutomationProperties.Name="{DynamicResource Recorder.Target.Window}"
                     ToolTip="{DynamicResource Recorder.Target.Window}"
                     IsChecked="{Binding Target, Converter={StaticResource Choice}, ConverterParameter=Window}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Window}" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Recorder.Target.Window}" />
          </StackPanel>
        </RadioButton>
        <RadioButton GroupName="Target" Style="{StaticResource Style.ToolButton}"
                     AutomationProperties.AutomationId="Target.Desktop"
                     AutomationProperties.Name="{DynamicResource Recorder.Target.Desktop}"
                     ToolTip="{DynamicResource Recorder.Target.Desktop}"
                     IsChecked="{Binding Target, Converter={StaticResource Choice}, ConverterParameter=Desktop}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Desktop}" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Recorder.Target.Desktop}" />
          </StackPanel>
        </RadioButton>

        <Border Width="1" Margin="6,6" Background="{DynamicResource Brush.Border}" />

        <!-- The three switches, each on its own; icon only, so each has a name. -->
        <ToggleButton Style="{StaticResource Style.Switch}"
                      AutomationProperties.AutomationId="SystemSoundSwitch"
                      AutomationProperties.Name="{DynamicResource Recorder.SystemSound}"
                      ToolTip="{DynamicResource Recorder.SystemSound}"
                      IsChecked="{Binding SystemSound}">
          <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Speaker}" />
        </ToggleButton>
        <ToggleButton Style="{StaticResource Style.Switch}"
                      AutomationProperties.AutomationId="MicrophoneSwitch"
                      AutomationProperties.Name="{DynamicResource Recorder.Microphone}"
                      ToolTip="{DynamicResource Recorder.Microphone}"
                      IsChecked="{Binding Microphone}">
          <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Microphone}" />
        </ToggleButton>
        <ToggleButton Style="{StaticResource Style.Switch}"
                      AutomationProperties.AutomationId="PointerSwitch"
                      AutomationProperties.Name="{DynamicResource Recorder.Pointer}"
                      ToolTip="{DynamicResource Recorder.Pointer}"
                      IsChecked="{Binding Pointer}">
          <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Pointer}" />
        </ToggleButton>

        <Border Width="1" Margin="6,6" Background="{DynamicResource Brush.Border}" />

        <Button Style="{StaticResource Style.Button.Accent}"
                AutomationProperties.AutomationId="RecordButton"
                AutomationProperties.Name="{DynamicResource Recorder.Record}"
                Command="{Binding RecordCommand}" IsDefault="True" Padding="10,6">
          <StackPanel Orientation="Horizontal">
            <Path Fill="{DynamicResource Brush.Recording}" Width="16" Height="16" Stretch="None" Data="{StaticResource Icon.Record}" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Recorder.Record}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Style.Button.Icon}"
                AutomationProperties.AutomationId="CloseButton"
                AutomationProperties.Name="{DynamicResource Recorder.Close}"
                ToolTip="{DynamicResource Recorder.Close}"
                Command="{Binding CloseCommand}" IsCancel="True">
          <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Close}" />
        </Button>
      </StackPanel>

      <!-- Why Record did not go on (F7). -->
      <TextBlock AutomationProperties.AutomationId="RecordingBarMessage"
                 Margin="4,6,4,0" TextWrapping="Wrap" MaxWidth="520"
                 Foreground="{DynamicResource Brush.Error}"
                 Text="{Binding MessageText}"
                 Visibility="{Binding HasMessage, Converter={StaticResource Visible}}" />
    </StackPanel>
  </Border>
</Window>
