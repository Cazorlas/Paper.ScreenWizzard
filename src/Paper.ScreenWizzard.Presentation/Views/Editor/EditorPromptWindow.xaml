<!-- A question with three answers, shown modally over the editor that asked: the first (accent, Enter) is the main answer, the second the
     other way to go on, the third backs out (Esc, and the title bar's X, do the same). No DataContext: the caller passes the title, the
     question and the three labels to the constructor, and reads Choice afterwards (0, 1 or 2). Used for "overwrite the original file or save
     a new one?" and "save, discard or go back?" (SPEC editor, "Lưu và chép" and F7). -->
<Window x:Class="Paper.ScreenWizzard.Presentation.Views.Editor.EditorPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="EditorPromptDialog"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        MaxWidth="520"
        MinWidth="360"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Paper.ScreenWizzard.Presentation;component/Resources/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <StackPanel Margin="24,20,24,16">
    <TextBlock x:Name="QuestionText"
               AutomationProperties.AutomationId="PromptText"
               Margin="0,0,0,18"
               TextWrapping="Wrap" />
    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="PrimaryButton"
              AutomationProperties.AutomationId="PromptPrimaryButton"
              Click="OnPrimaryClick"
              FontWeight="SemiBold"
              IsDefault="True"
              MinWidth="96"
              Style="{StaticResource Style.Button.Accent}" />
      <Button x:Name="SecondaryButton"
              AutomationProperties.AutomationId="PromptSecondaryButton"
              Click="OnSecondaryClick"
              Margin="8,0,0,0"
              MinWidth="96" />
      <Button x:Name="CancelButton"
              AutomationProperties.AutomationId="PromptCancelButton"
              Click="OnCancelClick"
              IsCancel="True"
              Margin="8,0,0,0"
              MinWidth="96" />
    </StackPanel>
  </StackPanel>
</Window>
