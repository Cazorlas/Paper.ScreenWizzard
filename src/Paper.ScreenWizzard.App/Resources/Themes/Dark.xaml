<!-- Dark theme: same keys as Light.xaml (a test compares the two key sets), darker values; contrast rules as in Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="Brush.Window" Color="#202020" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#2B2B2B" />

  <!-- Text -->
  <SolidColorBrush x:Key="Brush.Text" Color="#F5F5F5" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#C0C0C0" />
  <SolidColorBrush x:Key="Brush.DisabledText" Color="#7A7A7A" />
  <SolidColorBrush x:Key="Brush.Error" Color="#FF8A80" />

  <!-- Lines and glyphs -->
  <SolidColorBrush x:Key="Brush.Border" Color="#8A8A8A" />
  <SolidColorBrush x:Key="Brush.Icon" Color="#E6E6E6" />
  <SolidColorBrush x:Key="Brush.Focus" Color="#60CDFF" />

  <!-- Buttons -->
  <SolidColorBrush x:Key="Brush.ButtonBackground" Color="#3A3A3A" />
  <SolidColorBrush x:Key="Brush.ButtonHover" Color="#474747" />
  <SolidColorBrush x:Key="Brush.ButtonPressed" Color="#525252" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#60CDFF" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#7AD6FF" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#4DB8EA" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="#000000" />

  <!-- Toast: light on the dark window, for the same reason as in Light.xaml. -->
  <SolidColorBrush x:Key="Brush.ToastBackground" Color="#F3F3F3" />
  <SolidColorBrush x:Key="Brush.ToastText" Color="#1B1B1B" />
</ResourceDictionary>
