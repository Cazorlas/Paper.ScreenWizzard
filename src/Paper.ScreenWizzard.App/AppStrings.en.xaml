<!-- English text of the entry host (what only the composition root says: the crash box and the "open image" file box). Same keys as
     AppStrings.vi.xaml; the window text of the three features is in the Presentation project's Strings.en.xaml. {0} is a placeholder
     filled from NotificationMessage.Arguments. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:String x:Key="App.UnhandledError">Something went wrong: {0}. The app keeps running; the details are in the log file under %AppData%\Paper\ScreenWizzard\logs.</sys:String>
  <sys:String x:Key="App.OpenImage.Title">Open an image</sys:String>
  <sys:String x:Key="App.OpenImage.Filter">Images (*.png;*.jpg;*.jpeg;*.bmp)|*.png;*.jpg;*.jpeg;*.bmp|All files (*.*)|*.*</sys:String>
</ResourceDictionary>
