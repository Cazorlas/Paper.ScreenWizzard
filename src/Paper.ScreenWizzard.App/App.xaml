<!-- The application object. There is no StartupUri and no main window: the app lives in the tray, so it is shut down
     by an explicit Shutdown call (menu "Exit"), never by the last window closing. -->
<Application x:Class="Paper.ScreenWizzard.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources />
</Application>
