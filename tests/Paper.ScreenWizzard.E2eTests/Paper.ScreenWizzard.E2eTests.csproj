<Project Sdk="Microsoft.NET.Sdk">
  <!-- End-to-end tests: the real adapters and the real exe on the interactive desktop. They need the screen, so the ui and
       e2e lanes never run at the same time. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>Paper.ScreenWizzard.E2eTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The WPF SDK removes the System.IO implicit using; the tests use File and Directory everywhere and no WPF Path. -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Paper.ScreenWizzard.Infrastructure\Paper.ScreenWizzard.Infrastructure.csproj" />
    <!-- Presentation for the placement function of the editor window (pure, tested here with fake monitors). -->
    <ProjectReference Include="..\..\src\Paper.ScreenWizzard.Presentation\Paper.ScreenWizzard.Presentation.csproj" />
    <!-- The entry host, for the composition root: a test builds the container and resolves the whole graph (no window, no hotkey). -->
    <ProjectReference Include="..\..\src\Paper.ScreenWizzard.App\Paper.ScreenWizzard.App.csproj" />
    <ProjectReference Include="..\..\src\Paper.ScreenWizzard.UseCases\Paper.ScreenWizzard.UseCases.csproj" />
    <ProjectReference Include="..\..\src\Paper.ScreenWizzard.Domain\Paper.ScreenWizzard.Domain.csproj" />
  </ItemGroup>
</Project>
